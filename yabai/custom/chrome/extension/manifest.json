{
  "manifest_version": 3,
  "name": "Yabai \u00b7 ventanas y grupos",
  "version": "1.0.0",
  "description": "Conecta tus atajos locales con pesta\u00f1as y grupos de Chrome. Sin acceso al contenido de p\u00e1ginas.",
  "minimum_chrome_version": "110",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "nativeMessaging",
    "alarms"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Conectar con layouts de yabai"
  },
  "incognito": "not_allowed",
  "key": ""
}