{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "atlassian": {
      "command": ["/Users/williamquinones/.local/bin/uvx", "mcp-atlassian"],
      "enabled": true,
      "environment": {
        "JIRA_API_TOKEN": "{env:JIRA_API_TOKEN}",
        "JIRA_URL": "{env:JIRA_URL}",
        "JIRA_USERNAME": "{env:JIRA_USERNAME}"
      },
      "type": "local"
    },
    "context7": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "engram": {
      "command": ["/opt/homebrew/bin/engram", "mcp", "--tools=agent"],
      "type": "local"
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--autoConnect"]
    },
    "pencil": {
      "command": [
        "/Applications/Pen.app/Contents/Resources/app.asar.unpacked/out/mcp-server-darwin-arm64",
        "--app",
        "desktop",
        "--agent",
        "openCodeCLI"
      ],
      "enabled": true,
      "type": "local"
    }
  },
  "plugin": ["@warp-dot-dev/opencode-warp"],
  "permission": {
    "bash": {
      "git *": "allow",
      "git commit *": "allow",
      "git push *": "deny",
      "grep *": "allow"
    },
    "external_directory": {
      "/Users/williamquinones/Documents/DEV/**": "allow"
    }
  },
  "share": "disabled"
}
