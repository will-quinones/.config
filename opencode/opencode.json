{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "atlassian": {
      "command": [
        "/Users/williamquinones/.local/bin/uvx",
        "mcp-atlassian"
      ],
      "enabled": true,
      "environment": {
        "JIRA_API_TOKEN": "{env:JIRA_API_TOKEN}",
        "JIRA_URL": "{env:JIRA_URL}",
        "JIRA_USERNAME": "{env:JIRA_USERNAME}"
      },
      "type": "local"
    },
    "chrome-devtools": {
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--autoConnect"
      ],
      "type": "local"
    },
    "context7": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "pencil": {
      "command": [
        "/Applications/Pen.app/Contents/Resources/app.asar.unpacked/out/mcp-server-darwin-arm64",
        "--app",
        "desktop",
        "--agent",
        "openCodeCLI"
      ],
      "enabled": true,
      "type": "local"
    }
  },
  "permission": {
    "bash": {
      "git *": "allow",
      "git commit *": "allow",
      "git push *": "allow",
      "git push * *:develop": "deny",
      "git push * *:refs/heads/develop": "deny",
      "git push * *:refs/heads/stage": "deny",
      "git push * *:refs/heads/test": "deny",
      "git push * *:stage": "deny",
      "git push * *:test": "deny",
      "git push * develop": "deny",
      "git push * refs/heads/develop": "deny",
      "git push * refs/heads/stage": "deny",
      "git push * refs/heads/test": "deny",
      "git push * stage": "deny",
      "git push * test": "deny",
      "grep *": "allow"
    },
    "external_directory": {
      "/var/folders/yh/l267snw549x8dh_86zw72hwr0000gn/T/chrome-devtools-mcp-*/**": "allow",
      "/var/folders/yh/l267snw549x8dh_86zw72hwr0000gn/T/opencode/**": "allow",
      "~/.config/opencode/**": "allow",
      "~/.config/opencode/agents/**": "allow",
      "~/Documents/DEV/**": "allow",
      "~/Downloads/Nueva carpeta con elementos */**": "allow",
      "~/Downloads/Registro_bimestral_de_huespedes_*.xlsx": "allow"
    },
    "pencil_*": "deny"
  },
  "plugin": [
    "@warp-dot-dev/opencode-warp"
  ],
  "share": "disabled"
}
