{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "atlassian": {
        "type": "local",
        "command": [
          "/Users/williamquinones/.local/bin/uvx",
          "mcp-atlassian"
        ],
        "environment": {
          "JIRA_API_TOKEN": "{env:JIRA_API_TOKEN}",
          "JIRA_URL": "{env:JIRA_URL}",
          "JIRA_USERNAME": "{env:JIRA_USERNAME}"
        }
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--autoConnect"
        ]
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "pencil": {
        "type": "local",
        "command": [
          "/Applications/Pen.app/Contents/Resources/app.asar.unpacked/out/mcp-server-darwin-arm64",
          "--app",
          "desktop",
          "--agent",
          "openCodeCLI"
        ]
      },
      "notion": {
        "type": "remote",
        "url": "https://mcp.notion.com/mcp"
      }
    }
  },
  "permissions": [
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "~/Documents/DEV/**",
      "effect": "allow"
    }
  ],
  "share": "disabled"
}
